# Copy this file to .env in the backend working directory.
spring.profiles.active=mysql
DB_USERNAME=root
DB_PASSWORD=change-me
# Optional custom MySQL URL:
# DB_URL=jdbc:mysql://localhost:3306/campus_kb?createDatabaseIfNotExist=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Campus@2026

# OpenAI-compatible chat completions API. Keep the /v1 prefix if required by your provider.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your-api-key
# AI_MODEL=gpt-4o-mini

# Enable only if your provider supports the /embeddings endpoint.
AI_EMBEDDING_ENABLED=false
# AI_EMBEDDING_MODEL=text-embedding-3-small
SEED_DEMO=true
WEBSITE_SEARCH_ENABLED=true
